# Dracin Reels Backend — copy to .env and fill in. NEVER commit a real .env.
# No credentials are hardcoded in this repo.

PORT=8100
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dracin_reels
DB_USER=dracin_reels
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Alternative: set DATABASE_URL instead of the DB_* fields.
# DATABASE_URL=postgres://dracin_reels:CHANGE_ME@127.0.0.1:5432/dracin_reels?sslmode=disable
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
MEDIA_DIR=/opt/dracin-reels-backend/media
SEED_DEMO=true
